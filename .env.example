# Client (exposed to the browser)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Public site URL for link previews (og:image). Optional on Vercel, which provides it.
VITE_SITE_URL=
# Analytics is optional: leave the key empty and the app simply sends nothing.
# Use the project API key (starts with phc_). EU Cloud projects: https://eu.i.posthog.com
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Optional. Events are tagged env=development on localhost / your local network and env=production once deployed;
# set this to override (for example "staging").
VITE_APP_ENV=
# Optional. Player names are sent to PostHog as the person property "name" in development only;
# set to true to also send them in production.
VITE_POSTHOG_PERSON_NAMES=

# Server only (set in Vercel / .env for `vercel dev`; never prefix with VITE_)
GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-3.8-flash; check Google AI Studio for current names)
GEMINI_MODEL=
